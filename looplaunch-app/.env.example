# ──────────────────────────────────────────────
# Loop Launch — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.

# Google Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Crawl4AI Service URL (required for website crawling)
# Local Docker: http://localhost:11235
# Render: https://your-crawl4ai-service.onrender.com
CRAWL4AI_URL=http://localhost:11235

# Tavily Search API Key (optional — for market research)
TAVILY_API_KEY=

# Supabase Connection (required for persistent storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Production Site URL (used for sitemap, canonical links, and Open Graph previews)
# e.g., https://looplaunch.co or https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://looplaunch.co

# Google Search Console Verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Invite-only access: comma-separated emails that can use the real app (everyone else sees the waitlist).
# Optional; defaults to work@looplaunch.co,rhythmsarma66@gmail.com
TEAM_EMAILS=work@looplaunch.co,rhythmsarma66@gmail.com
# Waitlist is on unless this is "off". Off: anyone can run an analysis; signed-out visitors get
# their 7-day strategy, then must log in to keep chatting and to see the search intel.
WAITLIST_MODE=on

# Search Intel research budget (optional; these are the defaults). Ceilings, never targets.
MAX_INITIAL_QUESTIONS=10
MAX_INITIAL_ADS=10
MAX_INITIAL_COMPETITORS=10
# Paid SerpApi searches per analysis (cached results are free): discovery + competitor ads + Ad Library
MAX_COMPETITOR_DISCOVERY_QUERIES=2
MAX_AD_SEARCH_QUERIES=3
MAX_AD_LIBRARY_LOOKUPS=2
MAX_RESEARCH_RETRIES=1
# How long provider results are reused (needs migration 007 to survive restarts)
RESEARCH_CACHE_TTL_HOURS=72
# SerpApi engine for Google searches: google_ads (default; returns ads + organic + questions) or google
SERPAPI_SEARCH_ENGINE=google_ads
